<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV não tem tela de toque -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chip de rede: sinal e velocidade do Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Nome da rede Wi-Fi (SSID): o Android so entrega com permissao de localizacao (concedida por adb, ver README). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Foto do perfil: inicial da conta Google da TV. Liberada uma vez por adb (pm grant) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- Ordenar por uso recente: precisa ser liberada uma vez por adb (appops), não aparece como pop-up na TV -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Diagnóstico (04/11/2026): ler os crashes/ANRs de OUTROS apps (DropBoxManager exige READ_LOGS) e o motivo de o
         Android ter fechado cada app (ActivityManager.getHistoricalProcessExitReasons exige DUMP). As duas são de
         "desenvolvimento": o launcher se concede pelo próprio shell (GuardiaoShizuku.autocurar), sem PC. -->
    <uses-permission
        android:name="android.permission.READ_LOGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.DUMP"
        tools:ignore="ProtectedPermissions" />
    <!-- Abrir um app quando a TV reinicia -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Atualizador.kt: instalar a versão nova do próprio launcher (Device Owner instala sem perguntar). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Só declarada: permite que o app abra outro app a partir do receiver de boot (ver BootReceiver) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- DNS privado: o launcher grava Settings.Global (tela de DNS). Liberada uma vez por adb: pm grant ... WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Despertador: alarme no horário exato que acorda a TV (AlarmManager.setAlarmClock). USE_EXACT_ALARM vale do Android 13 em diante. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Agenda: ler os eventos (dada uma vez por adb: pm grant ... READ_CALENDAR) e ligar a sincronização da agenda Google -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />

    <!-- Painel no navegador (PainelWeb.kt, 04/11/2026). REQUEST_DELETE_PACKAGES: exigida pelo PackageInstaller.uninstall;
         como somos Device Owner, a desinstalação sai sem pedir confirmação na TV. (O painel também usa a QUERY_ALL_PACKAGES
         declarada mais abaixo, a do Shizuku sob demanda, para listar todos os apps.) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Fase 2 do painel: instalar APK enviado pelo navegador (em silêncio, por sermos Device Owner) e a aba Arquivos.
         MANAGE_EXTERNAL_STORAGE ("acesso a todos os arquivos") não se concede pelo Device Owner: o launcher se concede
         pelo próprio shell na primeira vez (PainelArquivos.garantirAcesso). Sem isso, só enxergaria as pastas dele. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Shizuku EMBUTIDO (MARCO S1): o launcher é o "gerente" do Shizuku. Estas são as permissões que o app Shizuku
         original declarava (fork thedjchi, manager/src/main/AndroidManifest.xml). Os apps clientes pedem a API_V23;
         quem decide se libera é o launcher (tela de permissão, MARCO S2). Não usamos a API_V23 nós mesmos: o servidor
         reconhece o gerente pelo nome do pacote. -->
    <permission-group
        android:name="moe.shizuku.manager.permission-group.API"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Shizuku" />
    <permission
        android:name="moe.shizuku.manager.permission.MANAGER"
        android:protectionLevel="signature" />
    <uses-permission android:name="moe.shizuku.manager.permission.MANAGER" />
    <!-- Shizuku sob demanda (04/11/2026): saber quais apps pedem o Shizuku (uses-permission API_V23) exige ver todos
         os pacotes instalados. App de uso pessoal, fora da Play Store. Ver ShizukuSobDemanda.kt. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        xmlns:tools="http://schemas.android.com/tools" tools:ignore="QueryAllPackagesPermission" />

    <permission
        android:name="moe.shizuku.manager.permission.API_V23"
        android:description="@string/shizuku_permissao_descricao"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/shizuku_permissao_nome"
        android:permissionGroup="moe.shizuku.manager.permission-group.API"
        android:protectionLevel="dangerous" />

    <!-- Android 11+ só deixa um app enxergar outros apps se isso for declarado aqui -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <!-- O launcher do Google (04/11/2026): sem isto o PackageManager diz que ele não existe, e o Home.kt
             (botão HOME pelo serviço de teclas, atalho do painel) achava que ele estava desativado. -->
        <package android:name="com.google.android.apps.tv.launcherx" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:banner="@android:drawable/sym_def_app_icon"
        android:label="Início"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".DiagnosticoActivity"
            android:exported="false"
            android:label="Diagnóstico" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME é o que faz o Android tratar este app como "tela inicial" -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LEANBACK_LAUNCHER deixa abrir pelo menu de apps da TV durante os testes -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- permission=DUMP: o BOOT_COMPLETED vem do sistema (que tem todas as permissões) e o TESTE_BOOT vem do adb.
             Sem isto qualquer app instalado podia disparar o TESTE_BOOT (religar a depuração, abrir app) — revisão 04/11. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Teste do shell proprio (MARCO 2): recebe o codigo de pareamento por adb broadcast (ver PareamentoReceiver) -->
        <!-- permission=DUMP: so o shell (adb) e o sistema tem essa permissao. Sem isto, QUALQUER app instalado na TV
             podia disparar o PAREAR e mandar o launcher abrir um shell. -->
        <receiver
            android:name=".PareamentoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="br.paulo.tvlauncher.PAREAR" />
            </intent-filter>
        </receiver>
        <!-- Serviço de acessibilidade: hoje só trata as teclas do controle remoto (ver AutorizaShizukuService.kt) -->
        <service
            android:name=".AutorizaShizukuService"
            android:exported="false"
            android:label="Teclas do controle"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/autoriza_acessibilidade" />
        </service>
        <!-- Lista para escolher o app dos botões Netflix/YouTube do controle (segurar 3 s, ver BotoesControle).
             Tinha sumido do manifest no commit df3d9c0; sem ela, segurar o botão derrubava a HOME
             (ActivityNotFoundException no processo do launcher). Devolvida em 04/11/2026. -->
        <activity
            android:name=".EscolherAppActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="Escolher app do botão" />
        <!-- Tela de DNS privado (aberta pelo chip do rodapé) -->
        <activity
            android:name=".DnsActivity"
            android:exported="false"
            android:label="DNS privado" />
        <!-- "Configurações do launcher": aparência, DNS, teste de velocidade, permissões, diagnóstico (aberta pelo card "Launcher" do popup do perfil) -->
        <activity
            android:name=".ConfigLauncherActivity"
            android:exported="false"
            android:label="Configurações do launcher" />
        <!-- Despertador: a lista/editor (abre no OK do relógio) e o "app de despertador" do Android (Gemini: "me acorda às 7"). -->
        <activity
            android:name=".AlarmesActivity"
            android:exported="true"
            android:label="Despertador"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Previsão do tempo em tela cheia (abre no OK do clima, no topo) -->
        <activity
            android:name=".PrevisaoActivity"
            android:exported="false"
            android:label="Previsão" />
        <!-- "Boletim do Tempo": um segundo "app" no menu da TV que abre a previsão e a lê em voz alta.
             Existe para o Google Assistant abrir por voz ("Ok Google, abrir Boletim do Tempo"). O launcher não o mostra na linha de apps. -->
        <activity-alias
            android:name=".BoletimDoTempo"
            android:exported="true"
            android:label="Boletim do Tempo"
            android:targetActivity=".PrevisaoActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <!-- Agenda do perfil ativo (abre no OK da data do topo) -->
        <activity
            android:name=".CalendarioActivity"
            android:exported="false"
            android:label="Agenda" />
        <!-- A tela que aparece quando o alarme toca: acende a tela mesmo em standby. -->
        <activity
            android:name=".AlarmeTocandoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <!-- Protetor de tela proprio (relogio + clima), leve. Apontamos screensaver_components do sistema para ele,
             aposentando o dreamx (~59 MB). Ver ProtetorTela.kt. -->
        <service
            android:name=".ProtetorTela"
            android:exported="true"
            android:label="Relógio"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Shizuku EMBUTIDO (MARCO S1): é por este provider que o servidor shizuku_server (uid 2000) entrega o binder
             dele ao launcher ("sendBinder"). Authority <pacote>.shizuku é a que o servidor procura. INTERACT_ACROSS_USERS_FULL:
             só o sistema e o shell podem chamar. Ver ProvedorShizuku.kt. -->
        <provider
            android:name=".ProvedorShizuku"
            android:authorities="${applicationId}.shizuku"
            android:directBootAware="true"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!-- Comandos INICIAR / PARAR / ESTADO do Shizuku embutido (ver ControleShizukuReceiver.kt). Dois receivers
             porque cada um só aceita uma permissão: apps autorizados (API_V23) e o adb (DUMP). -->
        <receiver
            android:name=".ControleShizukuReceiver"
            android:exported="true"
            android:permission="moe.shizuku.manager.permission.API_V23">
            <intent-filter>
                <action android:name="br.paulo.tvlauncher.shizuku.INICIAR" />
                <action android:name="br.paulo.tvlauncher.shizuku.PARAR" />
                <action android:name="br.paulo.tvlauncher.shizuku.ESTADO" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ControleShizukuAdbReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="br.paulo.tvlauncher.shizuku.INICIAR" />
                <action android:name="br.paulo.tvlauncher.shizuku.PARAR" />
                <action android:name="br.paulo.tvlauncher.shizuku.ESTADO" />
                <!-- Nomes reais dos apps para o painel do PC (chromecast-painel). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.ROTULOS" />
                <!-- Ocultar/reexibir um app pelo Device Owner (teste e desfazer). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.OCULTAR" />
                <action android:name="br.paulo.tvlauncher.REINICIAR" />
                <!-- Definir o PIN do painel no navegador e ligá-lo (testes). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.PAINEL_PIN" />
                <!-- Desligar sozinha: ver/definir/testar o aviso (testes). Só neste receiver (DUMP). -->
                <action android:name="br.paulo.tvlauncher.AUTO_DESLIGAR" />
            </intent-filter>
        </receiver>
        <!-- Pedido de permissão de um app cliente do Shizuku: o servidor abre esta tela quando um app chama
             Shizuku.requestPermission(). Só o sistema/shell podem abrir (INTERACT_ACROSS_USERS_FULL).
             MARCO S1: só registra no log e recusa; a tela de verdade é o MARCO S2. -->
        <activity
            android:name=".PedidoShizukuActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL">
            <intent-filter>
                <action android:name="${applicationId}.intent.action.REQUEST_PERMISSION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Resultado da desinstalação pedida pelo painel no navegador (PainelApps.desinstalar). Não exportado: só o
             PendingIntent do próprio launcher chega aqui. -->
        <receiver
            android:name=".ResultadoDesinstalarReceiver"
            android:exported="false" />

        <!-- Device owner (ver AdminReceiver.kt). Exportado porque o sistema precisa chamá-lo; só o sistema tem BIND_DEVICE_ADMIN. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <!-- Resposta do PackageInstaller para o Atualizador. exported=false: só o sistema (pelo PendingIntent) chega aqui. -->
        <receiver
            android:name=".Atualizador$Resultado"
            android:exported="false" />
    </application>
</manifest>
