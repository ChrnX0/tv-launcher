<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV não tem tela de toque -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chip de rede: sinal e velocidade do Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nome da rede Wi-Fi (SSID): o Android so entrega com permissao de localizacao (concedida por adb, ver README). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Foto do perfil: inicial da conta Google da TV. Liberada uma vez por adb (pm grant) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- Ordenar por uso recente: precisa ser liberada uma vez por adb (appops), não aparece como pop-up na TV -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Abrir um app quando a TV reinicia -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Só declarada: permite que o app abra outro app a partir do receiver de boot (ver BootReceiver) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- DNS privado: o launcher grava Settings.Global (tela de DNS). Liberada uma vez por adb: pm grant ... WRITE_SECURE_SETTINGS -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Despertador: alarme no horário exato que acorda a TV (AlarmManager.setAlarmClock). USE_EXACT_ALARM vale do Android 13 em diante. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Agenda: ler os eventos (dada uma vez por adb: pm grant ... READ_CALENDAR) e ligar a sincronização da agenda Google -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
    <!-- Permissão do Shizuku: sem ela o app não aparece na lista de apps autorizáveis dele -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!-- Android 11+ só deixa um app enxergar outros apps se isso for declarado aqui -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:testOnly="true"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:banner="@android:drawable/sym_def_app_icon"
        android:label="Início"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME é o que faz o Android tratar este app como "tela inicial" -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LEANBACK_LAUNCHER deixa abrir pelo menu de apps da TV durante os testes -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- Shizuku: o provider é por onde o Shizuku nos entrega o canal de comunicação (binder) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Aprova sozinho os pedidos de permissão ao Shizuku (ver AutorizaShizukuService) -->
        <service
            android:name=".AutorizaShizukuService"
            android:exported="false"
            android:label="Autoriza Shizuku"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/autoriza_acessibilidade" />
        </service>
        <!-- Tela de DNS privado (aberta pelo chip do rodapé) -->
        <activity
            android:name=".DnsActivity"
            android:exported="false"
            android:label="DNS privado" />
        <!-- Despertador: a lista/editor (abre no OK do relógio) e o "app de despertador" do Android (Gemini: "me acorda às 7"). -->
        <activity
            android:name=".AlarmesActivity"
            android:exported="true"
            android:label="Despertador"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Agenda do perfil ativo (abre no OK da data do topo) -->
        <activity
            android:name=".CalendarioActivity"
            android:exported="false"
            android:label="Agenda" />
        <!-- A tela que aparece quando o alarme toca: acende a tela mesmo em standby. -->
        <activity
            android:name=".AlarmeTocandoActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />
        <!-- Device owner (ver AdminReceiver.kt). Exportado porque o sistema precisa chamá-lo; só o sistema tem BIND_DEVICE_ADMIN. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
