<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android TV não tem tela de toque -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Chip de rede: sinal e velocidade do Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Nome da rede Wi-Fi (SSID): o Android so entrega com permissao de localizacao (concedida por adb, ver README). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Foto do perfil: inicial da conta Google da TV. Liberada uma vez por adb (pm grant) -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />
    <!-- Ordenar por uso recente: precisa ser liberada uma vez por adb (appops), não aparece como pop-up na TV -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Abrir um app quando a TV reinicia -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Só declarada: permite que o app abra outro app a partir do receiver de boot (ver BootReceiver) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ só deixa um app enxergar outros apps se isso for declarado aqui -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:banner="@android:drawable/sym_def_app_icon"
        android:label="Início"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode|density|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- HOME é o que faz o Android tratar este app como "tela inicial" -->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LEANBACK_LAUNCHER deixa abrir pelo menu de apps da TV durante os testes -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
