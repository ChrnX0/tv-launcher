<?xml version="1.0" encoding="utf-8"?>
<!-- Configuração do serviço de acessibilidade AutorizaShizukuService.
     Só escuta o app do Shizuku (packageNames): o serviço não vê nenhum outro app. -->
<!-- isAccessibilityTool="true" (Android 14+): sem isso o diálogo do Shizuku chega VAZIO ao serviço (0 filhos, nenhum evento),
     porque o Shizuku marca a janela como dado sensível. Descoberto no teste de 30/10. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/descricao_autoriza_shizuku"
    android:packageNames="moe.shizuku.privileged.api"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:isAccessibilityTool="true"
    android:notificationTimeout="100" />